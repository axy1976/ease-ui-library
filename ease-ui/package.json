{
  "name": "ease-ui",
  "version": "0.3.0",
  "description": "A lightweight, token-driven, accessible React UI library for Next.js — precise, enterprise-grade interfaces inspired by AWS / Amazon lightweight web UI components, without heavyweight framework dependencies.",
  "keywords": [
    "react",
    "next.js",
    "ui",
    "design-system",
    "components",
    "accessible",
    "table",
    "form"
  ],
  "license": "MIT",
  "author": "Ease UI contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/ease-ui/ease-ui.git"
  },
  "bugs": {
    "url": "https://github.com/ease-ui/ease-ui/issues"
  },
  "homepage": "https://github.com/ease-ui/ease-ui#readme",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./button": {
      "source": "./src/components/button/index.ts",
      "types": "./dist/components/button/index.d.ts",
      "import": "./dist/components/button/index.js",
      "default": "./dist/components/button/index.js"
    },
    "./icons": {
      "source": "./src/icons/index.ts",
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js",
      "default": "./dist/icons/index.js"
    },
    "./styles/tokens.css": "./dist/styles/tokens.css",
    "./styles/themes.css": "./dist/styles/themes.css",
    "./styles/components.css": "./dist/styles/components.css",
    "./styles/ease-ui.css": "./dist/styles/ease-ui.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "size": "node scripts/bundle-size.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset tag && changeset publish"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.5.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "globals": "^16.2.0",
    "jsdom": "^26.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.0"
  }
}
